// identity.jsonc — Identity test data for IIQ Test Automation Framework
//
// This file supports JSONC-style comments:
//   //  single-line comments
//   /* ... */  block comments (but don't nest them!)
//
// Sections:
//   create        — SCIM POST payload (no {suffix} — framework appends it)
//   verifyCreate  — expected state after creation (uses {suffix})
//   modify        — SCIM PATCH data (ONLY changed attributes, per qualifier "1", "2")
//   verifyModify  — expected state after modification (uses {suffix})
//
// Use {suffix} in expected values where the runtime suffix is injected.
// The suffix source is config.properties: test.suffix=random (or a fixed value).
//
// managerValue is an IIQ-instance-specific UUID. Update all occurrences
// when targeting a different IIQ environment (see README troubleshooting).
{
  "identities": {
    // First identity — full lifecycle with modify and account verification
    "user1": {
      "tests": [
        "create",
        "task:RefreshIdentitySingle",
        "task:LdapAccountAggregation",
        "verifyCreate",
        "modify:1",
        "verifyModify:1",
        "deleteAccounts",
        "delete"
      ],
      "descriptions": {
        "create": "Create the test user",
        "verifyCreate": "Verify core attributes, roles, and LDAP account after creation",
        "modify:1": "Update title and capabilities via SCIM PATCH",
        "verifyModify:1": "Verify the SCIM PATCH changes are reflected and LDAP account is unchanged",
        "task:RefreshIdentitySingle": "Refresh the identity to pick up changes from SCIM",
        "task:LdapAccountAggregation": "Trigger LDAP aggregation to provision accounts",
        "deleteAccounts": "Remove all provisioned accounts from LDAP prior to identity deletion",
        "delete": "Delete the test user"
      },
      // SCIM POST payload — framework appends suffix to userName and email
      "create": {
        "userName": "john.doe",
        "firstname": "John",
        "lastname": "Doe",
        "displayName": "John Doe",
        "email": "john.doe@acme.com",
        "userType": "employee",
        // <key>: this UUID is specific to your IIQ instance's "The Administrator"
        // Update when switching to a different IIQ environment
        "managerValue": "ac10c6819cc4176a819cc468045e00fe",
        "managerDisplayName": "The Administrator",
        "active": true,
        "sailpoint": {
          // Standard SailPoint attributes
          "title": "Software Engineer",
          "department": "Engineering",
          "location": "New York",
          // Custom attributes can be added here — no Java changes needed
          // They are treated as Map<String, Object> automatically
          "capabilities": [
            "Auditor",
            "RoleAdministrator"
          ]
        }
      },
      // Expected state after creation — {suffix} is resolved at runtime
      "verifyCreate": {
        "userName": "john.doe.{suffix}",
        "firstname": "John",
        "lastname": "Doe",
        "displayName": "John Doe",
        "email": "{suffix}.john.doe@acme.com",
        "userType": "employee",
        "managerValue": "ac10c6819cc4176a819cc468045e00fe",
        "managerDisplayName": "The Administrator",
        "active": true,
        "sailpoint": {
          "title": "Software Engineer",
          "department": "Engineering",
          "location": "New York",
          "capabilities": [
            "Auditor",
            "RoleAdministrator"
          ]
        },
        // Birthright roles expected after RefreshIdentitySingle
        "roles": [
          "ALL_ACTIVE_USERS",
          "LDAP_ALL_USERS"
        ],
        // Account verification per application (keyed by type)
        "accounts": {
          // LDAP account — expected to exist after LdapAccountAggregation
          "ldap": {
            "application": "LDAP-Test",
            "expected": {
              "exists": true,
              "attributes": {
                "uid": "john.doe.{suffix}",
                "cn": "john.doe.{suffix}",
                "givenName": "John",
                "sn": "Doe"
              }
            }
          },
          // AD account — expected NOT to exist for this identity
          "ad": {
            "application": "ActiveDirectory-Test",
            "expected": {
              "exists": false,
              "attributes": {
                "displayName": "John Doe",
                "givenName": "John",
                "mail": "{suffix}.john.doe@acme.com",
                "sAMAccountName": "john.doe.{suffix}",
                "sn": "Doe",
                "userAccountControl": "512",
                "userPrincipalName": "john.doe.{suffix}@acme.com"
              }
            }
          },
          // SCIM app account — expected NOT to exist
          "scim": {
            "application": "SCIM-Test",
            "expected": {
              "exists": false,
              "attributes": {
                "active": "true",
                "displayName": "John Doe",
                "familyName": "Doe",
                "givenName": "John",
                "mail": "{suffix}.john.doe@acme.com",
                "userName": "john.doe.{suffix}"
              }
            }
          }
        }
      },
      // Sparse modify data for SCIM PATCH — ONLY changed attributes per round
      // PATCH semantics: unspecified attributes are left unchanged
      "modify": {
        "1": {
          "displayName": "John Doe PATCHED",
          "sailpoint": {
            "title": "Senior Software Engineer",
            "capabilities": [
              "Auditor",
              "RuleAdministrator"
            ]
          }
        }
      },
      // Full expected state after modify — PUT semantics: all attributes
      // must be specified (both changed and unchanged)
      "verifyModify": {
        "1": {
          "userName": "john.doe.{suffix}",
          "firstname": "John",
          "lastname": "Doe",
          "displayName": "John Doe PATCHED",
          "email": "{suffix}.john.doe@acme.com",
          "userType": "employee",
          "managerValue": "ac10c6819cc4176a819cc468045e00fe",
          "managerDisplayName": "The Administrator",
          "active": true,
          "sailpoint": {
            "title": "Senior Software Engineer",
            "department": "Engineering",
            "location": "New York",
            "capabilities": [
              "Auditor",
              "RuleAdministrator"
            ]
          },
          "accounts": {
            "ad": {
              "application": "ActiveDirectory-Test",
              "expected": {
                "exists": false,
                "attributes": {
                  "displayName": "John Doe",
                  "givenName": "John",
                  "mail": "{suffix}.john.doe@acme.com",
                  "sAMAccountName": "john.doe.{suffix}",
                  "sn": "Doe",
                  "userAccountControl": "512",
                  "userPrincipalName": "john.doe.{suffix}@acme.com"
                }
              }
            }
          }
        }
      }
    },
    // Second identity — minimal lifecycle (create → verifyCreate → delete)
    "user2": {
      "tests": [
        "create",
        "task:RefreshIdentitySingle",
        "task:LdapAccountAggregation",
        "verifyCreate",
        "delete"
      ],
      "modify": {
        // Unqualified modify (key "") is used when there's no verifyModify phase
        "": {
          "displayName": "Jane Smith PATCHED",
          "sailpoint": {
            "title": "Senior Marketing Manager"
          }
        }
      },
      "verifyCreate": {
        "userName": "jane.smith.{suffix}",
        "firstname": "Jane",
        "lastname": "Smith",
        "displayName": "Jane Smith",
        "email": "{suffix}.jane.smith@acme.com",
        "userType": "employee",
        "managerValue": "ac10c6819cc4176a819cc468045e00fe",
        "managerDisplayName": "The Administrator",
        "active": true,
        "sailpoint": {
          "title": "Marketing Manager",
          "department": "Marketing",
          "location": "Chicago"
        },
        "roles": [
          "ALL_ACTIVE_USERS"
        ],
        "accounts": {
          "ldap": {
            "application": "LDAP-Test",
            "expected": {
              "exists": true,
              "attributes": {
                "uid": "jane.smith.{suffix}",
                "cn": "jane.smith.{suffix}",
                "givenName": "Jane",
                "sn": "Smith"
              }
            }
          }
        }
      },
      "verifyModify": {
        // Unqualified verifyModify (key "") corresponds to modify with qualifier ""
        "": {
          "userName": "jane.smith.{suffix}",
          "lastname": "Smith",
          "displayName": "Jane Smith PATCHED",
          "email": "{suffix}.jane.smith@acme.com",
          "userType": "employee",
          "managerValue": "ac10c6819cc4176a819cc468045e00fe",
          "managerDisplayName": "The Administrator",
          "active": true,
          "sailpoint": {
            "title": "Senior Marketing Manager",
            "department": "Marketing",
            "location": "Chicago"
          }
        }
      },
      "create": {
        "userName": "jane.smith",
        "firstname": "Jane",
        "lastname": "Smith",
        "displayName": "Jane Smith",
        "email": "jane.smith@acme.com",
        "userType": "employee",
        "managerValue": "ac10c6819cc4176a819cc468045e00fe",
        "managerDisplayName": "The Administrator",
        "active": true,
        "sailpoint": {
          "title": "Marketing Manager",
          "department": "Marketing",
          "location": "Chicago"
        }
      }
    }
  }
}
